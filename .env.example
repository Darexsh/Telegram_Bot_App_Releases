# Required
TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
GITHUB_USERNAME="YOUR_GITHUB_USERNAME"

# Optional bot branding
BOT_TITLE="Project Showcase"
BOT_FOOTER="Powered by Telegram + GitHub"
BOT_IDENTIFIER="telegram-showcase"

# Optional runtime tuning
MAX_REPOS=20
GITHUB_CACHE_TTL_SECONDS=300
GITHUB_MAX_RETRIES=2
GITHUB_RETRY_BACKOFF_SECONDS=0.8
TELEGRAM_SYNC_INTERVAL_SECONDS=86400
TELEGRAM_SYNC_RUN_ONCE=0
TELEGRAM_HEALTH_CACHE_TTL=60
